@app.post("/api/academy/videos/{video_id}/start")
def start_video(video_id: str, request: Request):
    user = require_user(request)
    data = get_user_academy(user["id"])
    if video_id not in data["completed"] and video_id not in data["in_progress"]:
        data["in_progress"].append(video_id)
    save_user_academy(user["id"], data)
    return {"ok": True}


@app.post("/api/academy/videos/{video_id}/{action}")
def toggle_video(
    video_id: str, action: str, request: Request, payload: Optional[TogglePayload] = None
):
    user = require_user(request)
    data = get_user_academy(user["id"])

    bucket = (
        "saved"
        if action in ("save", "saved", "bookmark")
        else "completed"
        if action in ("complete", "completed")
        else None
    )
    if not bucket:
        raise HTTPException(status_code=400, detail=f"Unsupported action: {action}")

    should_add = (
        bool(payload.value)
        if (payload and payload.value is not None)
        else (video_id not in data[bucket])
    )

    if should_add and video_id not in data[bucket]:
        data[bucket].append(video_id)
        if bucket == "completed" and video_id in data["in_progress"]:
            data["in_progress"].remove(video_id)
    elif not should_add and video_id in data[bucket]:
        data[bucket].remove(video_id)

    save_user_academy(user["id"], data)
    return {"ok": True}

